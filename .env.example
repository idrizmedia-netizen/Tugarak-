# Firebase konsolidan (Project settings → Your apps → Web app → SDK setup) oling
# Bu qiymatlarni Vercel loyihangizning Environment Variables bo'limiga ham qo'shing

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Administrator sifatida kirish huquqi beriladigan email(lar), vergul bilan ajrating.
# Bu ro'yxat admins/{uid} Firestore hujjatlarini yaratish uchun ham README'dagi
# ko'rsatma bo'yicha ishlatiladi.
VITE_ADMIN_EMAILS=admin@sizningmaktab.uz
