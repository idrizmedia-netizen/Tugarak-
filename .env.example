# Firebase konsolidan (Project settings → Your apps → Web app → SDK setup) oling
# Bu qiymatlarni Vercel loyihangizning Environment Variables bo'limiga ham qo'shing

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Administratorlar .env orqali emas, Firestore'dagi admins/{uid} hujjati orqali belgilanadi (README'ga qarang).
