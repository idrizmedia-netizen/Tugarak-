rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- yordamchi funksiyalar ---------- */
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // MUHIM: ma'lumot yozish faqat administrator TASDIQLAGAN o'qituvchilarga ruxsat.
    // (Avval bu tekshiruv faqat brauzerda edi — tasdiqlanmagan hisob ham to'g'ridan-to'g'ri yozishi mumkin edi.)
    function isApproved() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'approved';
    }
    function groupData(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }
    // Guruh egasi yoki hamkor o'qituvchisi
    function isGroupMember(gid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(gid))
        && (groupData(gid).teacherId == request.auth.uid
            || request.auth.uid in groupData(gid).get('coTeachers', []));
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }
    function nonEmptyStr(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    /* ---------- admins ---------- */
    // Faqat konsoldan qo'lda yaratiladi. Foydalanuvchi faqat O'ZINING hujjatini o'qiy oladi
    // (avval hamma administratorlar UID ro'yxatini ko'ra olardi).
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow write: if false;
    }

    /* ---------- teacherDirectory: hamkor qo'shish uchun email -> uid katalogi ----------
       Faqat aniq email bo'yicha o'qiladi (get), ro'yxat qilib bo'lmaydi. Yozishni admin
       o'qituvchini tasdiqlayotganda amalga oshiradi. */
    match /teacherDirectory/{key} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isAdmin();
    }

    /* ---------- users: o'qituvchi profili ---------- */
    function validNewUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['role', 'fullName', 'email', 'phone', 'method', 'status',
                               'contractAccepted', 'contractDate', 'createdAt'])
        && d.keys().hasAll(['role', 'fullName', 'email', 'phone', 'method', 'status', 'contractAccepted'])
        && d.role == 'teacher'
        && nonEmptyStr(d.fullName, 100)
        && str(d.phone, 30)
        && d.email is string
        && d.email.lower() == request.auth.token.email.lower()
        && d.method in ['password', 'google']
        && ((d.status == 'pending' && d.contractAccepted == true)
            || (d.status == 'incomplete' && d.contractAccepted == false));
    }

    match /users/{uid} {
      // Faqat o'zi yoki admin. (Avval har qanday kirgan foydalanuvchi barcha tasdiqlangan
      // o'qituvchilarning email va telefonini ro'yxat qilib o'qiy olardi.)
      allow read: if isOwner(uid) || isAdmin();

      // Yangi hisob: faqat ruxsat etilgan maydonlar. plan/planExpiresAt kabi maydonlarni
      // o'zi yozib "pullik reja"ni bepul olishi mumkin emas.
      allow create: if isOwner(uid) && validNewUser();

      allow update: if isAdmin()
        // Google-registratsiyani yakunlash: incomplete -> pending
        || (isOwner(uid)
            && resource.data.status == 'incomplete'
            && request.resource.data.status == 'pending'
            && changedKeys().hasOnly(['phone', 'status', 'contractAccepted', 'contractDate'])
            && request.resource.data.contractAccepted == true
            && str(request.resource.data.phone, 30))
        // Rad etilgan ariza qayta yuborilishi: rejected -> pending (faqat shu maydonlar)
        || (isOwner(uid)
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && changedKeys().hasOnly(['status', 'resubmitReason', 'rejectionReason', 'resubmittedAt', 'proofDocs'])
            && str(request.resource.data.get('resubmitReason', ''), 500)
            && request.resource.data.get('proofDocs', []).size() <= 10)
        // O'qituvchi o'z profilining xavfsiz maydonlarini yangilashi
        || (isOwner(uid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.role == resource.data.role
            && changedKeys().hasOnly(['fullName', 'phone', 'selectedPlan', 'planContacted', 'planChosenAt'])
            && nonEmptyStr(request.resource.data.fullName, 100)
            && str(request.resource.data.phone, 30)
            && (!changedKeys().hasAny(['selectedPlan'])
                || request.resource.data.selectedPlan in ['free', 'monthly', 'yearly']))
        // Obunani o'zi bekor qilishi (faqat bepul rejaga qaytish)
        || (isOwner(uid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.plan == 'free'
            && request.resource.data.get('planExpiresAt', null) == null
            && changedKeys().hasOnly(['plan', 'planExpiresAt', 'selectedPlan', 'planContacted']));

      allow delete: if isAdmin();
    }

    /* ---------- groups ---------- */
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid
        || request.auth.uid in resource.data.get('coTeachers', [])
        || isAdmin()
      );
      allow create: if isApproved()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(['teacherId', 'name', 'subject', 'coTeachers', 'createdAt'])
        && nonEmptyStr(request.resource.data.name, 80)
        && nonEmptyStr(request.resource.data.subject, 80)
        && request.resource.data.coTeachers == [];
      // Egasi nom/fan va hamkorlarni o'zgartira oladi; teacherId (egalik) o'zgartirilmaydi.
      allow update: if isApproved()
        && resource.data.teacherId == request.auth.uid
        && changedKeys().hasOnly(['name', 'subject', 'coTeachers', 'coTeacherInfo'])
        && (!changedKeys().hasAny(['name']) || nonEmptyStr(request.resource.data.name, 80))
        && (!changedKeys().hasAny(['subject']) || nonEmptyStr(request.resource.data.subject, 80))
        && request.resource.data.coTeachers is list
        && request.resource.data.coTeachers.size() <= 10
        && !(request.auth.uid in request.resource.data.coTeachers);
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    /* ---------- students ----------
       Kirish huquqi faqat GURUH A'ZOLIGIGA bog'liq (egasi + hamkorlar). Avval o'quvchini
       yaratgan o'qituvchi (teacherId) hamkorlikdan chiqarilgandan keyin ham o'quvchilarga
       kirishda davom etardi. */
    function validNewStudent() {
      let d = request.resource.data;
      return d.keys().hasOnly(['teacherId', 'groupId', 'fullName', 'className', 'photo', 'fromPhoto',
                               'birthDate', 'address', 'grades', 'createdAt'])
        && d.teacherId == request.auth.uid
        && nonEmptyStr(d.fullName, 120)
        && str(d.className, 40)
        && str(d.birthDate, 10)
        && str(d.address, 200)
        && (d.photo == null || (d.photo is string && d.photo.size() < 250000))
        && d.grades is list && d.grades.size() == 0;
    }
    function validStudentUpdate() {
      let d = request.resource.data;
      return changedKeys().hasOnly(['grades', 'fullName', 'className', 'photo', 'fromPhoto', 'birthDate', 'address'])
        && (!changedKeys().hasAny(['fullName']) || nonEmptyStr(d.fullName, 120))
        && (!changedKeys().hasAny(['className']) || str(d.className, 40))
        && (!changedKeys().hasAny(['photo']) || d.photo == null || (d.photo is string && d.photo.size() < 250000))
        && d.grades is list && d.grades.size() <= 300;
    }
    match /students/{studentId} {
      allow read: if isSignedIn() && (isGroupMember(resource.data.groupId) || isAdmin());
      allow create: if isApproved()
        && isGroupMember(request.resource.data.groupId)
        && validNewStudent();
      allow update: if isApproved()
        && isGroupMember(resource.data.groupId)
        && validStudentUpdate();
      allow delete: if isSignedIn() && (isGroupMember(resource.data.groupId) || isAdmin());
    }

    /* ---------- groupDocs: ish reja / dars ishlanmasi fayllari ---------- */
    function validNewGroupDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['teacherId', 'groupId', 'title', 'category', 'fileName', 'fileData', 'createdAt'])
        && d.teacherId == request.auth.uid
        && nonEmptyStr(d.title, 120)
        && d.category in ['workplan', 'lesson']
        && nonEmptyStr(d.fileName, 150)
        && d.fileData is string
        && d.fileData.size() < 800000
        && d.fileData.matches('data:[a-z0-9/.+-]*;base64,.*');
    }
    match /groupDocs/{docId} {
      allow read: if isSignedIn() && (isGroupMember(resource.data.groupId) || isAdmin());
      allow create: if isApproved()
        && isGroupMember(request.resource.data.groupId)
        && validNewGroupDoc();
      // Hujjatni tahrirlab bo'lmaydi (yangisini yuklab, eskisini o'chiriladi)
      allow update: if false;
      allow delete: if isSignedIn() && (isGroupMember(resource.data.groupId) || isAdmin());
    }

    /* ---------- attendance: davomat (docId = groupId_sana) ---------- */
    function validAttendance(recordId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['teacherId', 'groupId', 'date', 'records', 'updatedAt'])
        && d.teacherId == request.auth.uid
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && recordId == d.groupId + '_' + d.date
        && d.records is map
        && d.records.size() <= 500;
    }
    match /attendance/{recordId} {
      allow read: if isSignedIn() && (isGroupMember(resource.data.groupId) || isAdmin());
      allow create: if isApproved()
        && isGroupMember(request.resource.data.groupId)
        && validAttendance(recordId);
      allow update: if isApproved()
        && isGroupMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && validAttendance(recordId);
      allow delete: if isSignedIn() && (isGroupMember(resource.data.groupId) || isAdmin());
    }

    /* ---------- workPlans: yillik ish reja (docId = groupId) ---------- */
    function validWorkPlan(groupId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['teacherId', 'groupId', 'items'])
        && d.teacherId == request.auth.uid
        && d.groupId == groupId
        && d.items is list
        && d.items.size() <= 300;
    }
    match /workPlans/{groupId} {
      allow read: if isSignedIn() && (isGroupMember(groupId) || isAdmin());
      allow create, update: if isApproved() && isGroupMember(groupId) && validWorkPlan(groupId);
      allow delete: if isSignedIn() && isGroupMember(groupId);
    }

    /* ---------- bildirishnomalar: admin yozadi, hamma o'qiydi ---------- */
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ---------- reklamalar: admin yozadi, hamma o'qiydi ---------- */
    match /ads/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ---------- settings (obuna rejalari): admin yozadi, hamma o'qiydi ---------- */
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
