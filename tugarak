/* ============================================================
   EVENT HANDLERS
============================================================ */
function attachHandlers(){
  document.getElementById('themeToggle')?.addEventListener('click', async ()=>{
    state.theme = state.theme==='dark' ? 'light' : 'dark';
    await saveTheme();
    render();
  });
  document.getElementById('logoutBtn')?.addEventListener('click', async ()=>{
    state.session = null; state.view='landing'; state.activeGroupId=null;
    await saveSession(); render();
  });
  document.querySelectorAll('[data-goto]').forEach(el=>{
    el.addEventListener('click', ()=>{ state.view = el.dataset.goto; state.resetStage=null; render(); });
  });
  document.querySelectorAll('[data-nav]').forEach(el=>{
    el.addEventListener('click', ()=>{ state.view = el.dataset.nav; render(); });
  });
  document.querySelectorAll('[data-tab]').forEach(el=>{
    el.addEventListener('click', ()=>{ state.authTab = el.dataset.tab; render(); });
  });

  /* ---- Teacher login ---- */
  document.getElementById('teacherLoginForm')?.addEventListener('submit', async (e)=>{
    e.preventDefault();
    const email = document.getElementById('tlEmail').value.trim().toLowerCase();
    const pass = document.getElementById('tlPass').value;
    state.authEmailTry = email;
    const lockKey = 'teacher::'+email;
    if(getLockInfo(lockKey).locked){ toast('Hisobingiz vaqtincha bloklangan.', 'error'); return; }
    const t = state.teachers.find(x=>x.email.toLowerCase()===email);
    if(!t || t.passwordHash !== simpleHash(pass)){
      const count = registerFail(lockKey);
      toast(`Email yoki parol xato. Urinish: ${count}/${LOCK_AFTER}`, 'error');
      render();
      startLockCountdownIfNeeded();
      return;
    }
    clearFails(lockKey);
    state.session = {role:'teacher', teacherId:t.id};
    await saveSession();
    state.view = t.status==='approved' ? 'teacherDash' : 'teacherPending';
    render();
  });

  document.getElementById('googleLoginBtn')?.addEventListener('click', ()=>{
    toast('Bu demo muhitida Google OAuth simulyatsiya qilinmoqda. Haqiqiy integratsiya uchun backend (Google Client ID) kerak.', 'info');
    // Demo: create/find a mock google teacher
    (async ()=>{
      let t = state.teachers.find(x=>x.email==='google.demo@gmail.com');
      if(!t){
        t = {id:uid(), fullName:'Google foydalanuvchi', email:'google.demo@gmail.com', phone:'—', passwordHash:null, method:'google', status:'pending', contract:{accepted:false,date:null}, createdAt:now()};
        state.teachers.push(t); await saveTeachers();
      }
      state.session = {role:'teacher', teacherId:t.id};
      await saveSession();
      state.view = t.status==='approved' ? 'teacherDash' : 'teacherPending';
      render();
    })();
  });

  document.getElementById('forgotBtn')?.addEventListener('click', ()=>{ state.resetStage='email'; render(); });
  document.getElementById('cancelResetBtn')?.addEventListener('click', ()=>{ state.resetStage=null; render(); });
  document.getElementById('sendResetBtn')?.addEventListener('click', ()=>{
    const email = document.getElementById('resetEmailInput').value.trim().toLowerCase();
    const t = state.teachers.find(x=>x.email.toLowerCase()===email);
    if(!t){ toast('Bunday email topilmadi.', 'error'); return; }
    state.resetEmail = email;
    state.resetCode = String(Math.floor(100000+Math.random()*900000));
    state.resetStage = 'code';
    render();
  });
  document.getElementById('confirmResetBtn')?.addEventListener('click', async ()=>{
    const code = document.getElementById('resetCodeInput').value.trim();
    const newPass = document.getElementById('resetNewPass').value;
    if(code !== state.resetCode){ toast('Kod noto\\'g\\'ri.', 'error'); return; }
    if(!newPass || newPass.length<6){ toast('Parol kamida 6 belgidan iborat bo\\'lsin.', 'error'); return; }
    const t = state.teachers.find(x=>x.email.toLowerCase()===state.resetEmail);
    t.passwordHash = simpleHash(newPass);
    await saveTeachers();
    state.resetStage=null;
    toast('Parol muvaffaqiyatli yangilandi. Endi kirishingiz mumkin.', 'info');
    render();
  });

  /* ---- Teacher register ---- */
  document.getElementById('openContractBtn')?.addEventListener('click', ()=>{
    state.modal = {type:'contract'}; render();
  });
  document.getElementById('teacherRegForm')?.addEventListener('submit', async (e)=>{
    e.preventDefault();
    if(!state.pendingRegister?.contractAccepted){ toast('Avval shartnomani tasdiqlang.', 'error'); return; }
    const fullName = document.getElementById('rName').value.trim();
    const email = document.getElementById('rEmail').value.trim();
    const phone = document.getElementById('rPhone').value.trim();
    const pass = document.getElementById('rPass').value;
    if(state.teachers.some(t=>t.email.toLowerCase()===email.toLowerCase())){
      toast('Bu email allaqachon ro\\'yxatdan o\\'tgan.', 'error'); return;
    }
    const t = {id:uid(), fullName, email, phone, passwordHash:simpleHash(pass), method:'password',
      status:'pending', contract:{accepted:true, date:now()}, createdAt:now()};
    state.teachers.push(t);
    await saveTeachers();
    state.session = {role:'teacher', teacherId:t.id};
    await saveSession();
    state.pendingRegister = null;
    state.view = 'teacherPending';
    toast('Ariza yuborildi! Administrator tasdiqlashini kuting.', 'info');
    render();
  });

  /* ---- Admin login ---- */
  document.getElementById('adminLoginForm')?.addEventListener('submit', async (e)=>{
    e.preventDefault();
    const email = document.getElementById('aEmail').value.trim().toLowerCase();
    const pass = document.getElementById('aPass').value;
    const lockKey = 'admin::'+ADMIN_CREDS.email;
    if(getLockInfo(lockKey).locked){ toast('Hisob vaqtincha bloklangan.', 'error'); return; }
    if(email !== ADMIN_CREDS.email.toLowerCase() || pass !== ADMIN_CREDS.password){
      const count = registerFail(lockKey);
      toast(`Email yoki parol xato. Urinish: ${count}/${LOCK_AFTER}`, 'error');
      render(); startLockCountdownIfNeeded();
      return;
    }
    clearFails(lockKey);
    state.session = {role:'admin'};
    await saveSession();
    state.view = 'adminDash';
    render();
  });

  /* ---- Admin actions ---- */
  document.querySelectorAll('[data-approve]').forEach(el=>{
    el.addEventListener('click', async ()=>{
      const t = state.teachers.find(x=>x.id===el.dataset.approve);
      t.status='approved'; await saveTeachers(); toast('O\\'qituvchi tasdiqlandi.', 'info'); render();
    });
  });
  document.querySelectorAll('[data-reject]').forEach(el=>{
    el.addEventListener('click', async ()=>{
      const t = state.teachers.find(x=>x.id===el.dataset.reject);
      t.status='rejected'; await saveTeachers(); toast('Ariza rad etildi.', 'info'); render();
    });
  });
  document.querySelectorAll('[data-viewcontract]').forEach(el=>{
    el.addEventListener('click', ()=>{ state.modal = {type:'viewContract', teacherId:el.dataset.viewcontract}; render(); });
  });

  /* ---- Teacher dashboard actions ---- */
  document.getElementById('newGroupBtn')?.addEventListener('click', ()=>{ state.modal={type:'newGroup'}; render(); });
  document.querySelectorAll('[data-selectgroup]').forEach(el=>{
    el.addEventListener('click', ()=>{ state.activeGroupId = el.dataset.selectgroup; render(); });
  });
  document.getElementById('addManualBtn')?.addEventListener('click', ()=>{ state.modal={type:'addManual'}; render(); });
  document.getElementById('addPhotoBtn')?.addEventListener('click', ()=>{ state.modal={type:'addPhoto'}; render(); });
  document.getElementById('printBtn')?.addEventListener('click', ()=>{ window.print(); });
  document.querySelectorAll('[data-addgrade]').forEach(el=>{
    el.addEventListener('click', ()=>{ state.modal={type:'addGrade', studentId:el.dataset.addgrade}; render(); });
  });
  document.querySelectorAll('[data-delstudent]').forEach(el=>{
    el.addEventListener('click', async ()=>{
      state.students = state.students.filter(s=>s.id!==el.dataset.delstudent);
      await saveStudents(); render();
    });
  });

  /* ---- Modal handlers ---- */
  document.getElementById('modalCancel')?.addEventListener('click', ()=>{ state.modal=null; render(); });
  document.getElementById('modalBg')?.addEventListener('click', (e)=>{ if(e.target.id==='modalBg'){ state.modal=null; render(); } });

  document.getElementById('modalAccept')?.addEventListener('click', ()=>{
    const checked = document.getElementById('contractCheck').checked;
    if(!checked){ toast('Iltimos, avval belgini bosing.', 'error'); return; }
    state.pendingRegister = {contractAccepted:true};
    state.modal = null;
    render();
  });

  document.getElementById('ngSave')?.addEventListener('click', async ()=>{
    const name = document.getElementById('ngName').value.trim();
    const subject = document.getElementById('ngSubject').value.trim();
    if(!name||!subject){ toast('Barcha maydonlarni to\\'ldiring.', 'error'); return; }
    const g = {id:uid(), teacherId:state.session.teacherId, name, subject, createdAt:now()};
    state.groups.push(g); await saveGroups();
    state.activeGroupId = g.id;
    state.modal=null; render();
  });

  document.getElementById('amSave')?.addEventListener('click', async ()=>{
    const name = document.getElementById('amName').value.trim();
    const cls = document.getElementById('amClass').value.trim();
    if(!name){ toast('Ismni kiriting.', 'error'); return; }
    const s = {id:uid(), groupId:state.activeGroupId, fullName:name, className:cls, photo:null, grades:[], fromPhoto:false};
    state.students.push(s); await saveStudents();
    state.modal=null; render();
  });

  let photoData = null;
  document.getElementById('photoDropZone')?.addEventListener('click', ()=>{ document.getElementById('photoInput').click(); });
  document.getElementById('photoInput')?.addEventListener('change', (e)=>{
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = (ev)=>{
      const img = new Image();
      img.onload = ()=>{
        const canvas = document.createElement('canvas');
        const maxW = 640; const scale = Math.min(1, maxW/img.width);
        canvas.width = img.width*scale; canvas.height = img.height*scale;
        canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);
        photoData = canvas.toDataURL('image/jpeg', 0.7);
        document.getElementById('photoPreviewWrap').innerHTML = `<img src="${photoData}" style="width:100%;border-radius:8px;margin-top:10px;border:1px solid var(--line);">`;
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  });
  document.getElementById('apSave')?.addEventListener('click', async ()=>{
    const name = document.getElementById('apName').value.trim();
    const cls = document.getElementById('apClass').value.trim();
    if(!name){ toast('Ismni kiriting.', 'error'); return; }
    const s = {id:uid(), groupId:state.activeGroupId, fullName:name, className:cls, photo:photoData, grades:[], fromPhoto:!!photoData};
    state.students.push(s); await saveStudents();
    photoData = null;
    state.modal=null; render();
  });

  document.getElementById('agSave')?.addEventListener('click', async ()=>{
    const subject = document.getElementById('agSubject').value.trim();
    const value = parseInt(document.getElementById('agValue').value);
    if(!subject){ toast('Fan nomini kiriting.', 'error'); return; }
    const s = state.students.find(x=>x.id===state.modal.studentId);
    s.grades = s.grades || [];
    s.grades.push({subject, value, date:now()});
    await saveStudents();
    state.modal=null; render();
  });
}

function startLockCountdownIfNeeded(){
  const el = document.getElementById('lockCountdown');
  if(!el) return;
  const timer = setInterval(()=>{
    const cur = document.getElementById('lockCountdown');
    if(!cur){ clearInterval(timer); return; }
    let secs = parseInt(cur.textContent);
    secs -= 1;
    if(secs <= 0){ clearInterval(timer); render(); }
    else cur.textContent = secs+'s';
  }, 1000);
}

/* ---------- INIT ---------- */
(async function init(){
  await loadAll();
  if(state.session){
    state.view = state.session.role==='admin' ? 'adminDash' : 'teacherDash';
  }
  render();
})();
</script>
</body>
</html>
