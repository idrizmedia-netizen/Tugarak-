/* ---------- lockout helpers ---------- */
function getLockInfo(key){
  const raw = localStorage.getItem('lock:'+key);
  if(!raw) return {locked:false};
  const data = JSON.parse(raw);
  const remaining = Math.ceil((data.until - now())/1000);
  if(remaining > 0) return {locked:true, remaining};
  return {locked:false};
}
function registerFail(key){
  const raw = localStorage.getItem('fails:'+key);
  const count = (raw?parseInt(raw):0) + 1;
  localStorage.setItem('fails:'+key, count);
  if(count >= LOCK_AFTER){
    localStorage.setItem('lock:'+key, JSON.stringify({until: now()+LOCK_SECONDS*1000}));
    localStorage.removeItem('fails:'+key);
  }
  return count;
}
function clearFails(key){ localStorage.removeItem('fails:'+key); localStorage.removeItem('lock:'+key); }

